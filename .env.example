# Supabase (프로젝트 Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# 서버 비밀값: 아무 긴 랜덤 문자열. supabase/schema.sql의 rally.server_secret 값과 같아야 해요.
PUSH_SECRET=

# Web Push (npx web-push generate-vapid-keys 로 생성)
# 공개키는 app/actions.ts, app/dues.ts, app/promo.ts, app/api/cron/route.ts, lib/club-push.ts, components/push.tsx 안의 VAPID_PUBLIC 상수도 같이 바꿔야 해요.
VAPID_PRIVATE_KEY=

# Vercel Cron 인증용 랜덤 문자열 (매일 오전 9시 자동 알림)
CRON_SECRET=
